# ─────────────────────────────────────────────────────────────────────────────
# Business Core — variables d'environnement de PRODUCTION
#
# À copier en `.env` À CÔTÉ du docker-compose.yml, SUR LE SERVEUR, puis
# `docker compose up -d --build`. Ce fichier-ci n'est qu'un modèle : il ne contient
# aucun secret réel et peut rester versionné.
#
# Valeurs relevées sur le déploiement en service le 31/07/2026 :
#   Frontend : https://business-core.yowyob.com
#   API      : https://business-core.yowyob.com/business-core-api
#              (un reverse proxy route ce préfixe vers le conteneur, port 8080)
# ─────────────────────────────────────────────────────────────────────────────

# --- Port publié par le conteneur (le reverse proxy pointe dessus) ---
APP_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# --- Base de données (interne au conteneur : ne pas exposer) ---
BC_DB_NAME=businesscore
BC_DB_OWNER_PASSWORD=<mot-de-passe-fort-owner>
BC_DB_APP_PASSWORD=<mot-de-passe-fort-app>

# --- Plateforme d'identité ---
# NE JAMAIS laisser vide : une valeur vide fait retomber l'application sur le
# simulateur local (WireMock) et TOUS les appels échouent silencieusement.
KERNEL_BASE_URL=https://kernel-core.yowyob.com
KERNEL_CLIENT_ID=<client-id>
KERNEL_CLIENT_SECRET=<client-secret>

# --- Chiffrement au repos des secrets (clés API) ---
# 32 caractères minimum. La changer rend illisibles les clés déjà émises.
BC_ENCRYPTION_KEY=<cle-de-32-caracteres-minimum>

# --- CORS : le domaine du frontend, pas "*" en production ---
BC_CORS_ORIGINS=https://business-core.yowyob.com

# --- Administrateurs de la console (séparés par des virgules) ---
BC_ADMIN_EMAILS=migueladmin@yowyob.com

# --- Paiement (changement de forfait) ---
# IMPÉRATIF : URL PUBLIQUE. La passerelle refuse explicitement toute adresse locale
# ou privée (« callbackUrl must not target a local or private host »). Avec une
# valeur localhost, aucun changement de forfait n'est possible.
BC_PAYMENT_CALLBACK_BASE_URL=https://business-core.yowyob.com/console/pricing
# Optionnels — défauts sûrs, à ne surcharger qu'en cas de changement de passerelle :
# BC_PAYMENT_CLIENT_ID=business-core
# BC_PAYMENT_PROVIDER=MYCOOLPAY          (mobile money)
# BC_PAYMENT_PROVIDER_CARTE=STRIPE       (carte bancaire)
# BC_PAYMENT_METHOD=MOBILE_MONEY
# BC_PAYMENT_CURRENCY=XAF
# BC_PAYMENT_SERVICE_CODE_PREFIX=PLAN_UPGRADE_
