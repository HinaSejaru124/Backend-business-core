<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Facturation (feature). Auto-inclus par includeAll après _socle.xml (qui crée developer_account).
      NE MODIFIE aucun changelog existant. Préfixe d'IDs : billing-xxx.

      plan_change_request : audit des demandes de changement de plan (upgrade/downgrade) et de leur issue
      de paiement. Rattachée au compte développeur (pas de donnée métier tenant) -> pas de RLS, comme
      developer_account / api_key / api_key_usage_daily.
    -->
    <changeSet id="billing-001-plan-change-request" author="billing">
        <createTable tableName="plan_change_request">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="developer_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="plan_from" type="varchar(32)"/>
            <column name="plan_to" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="statut" type="varchar(16)">
                <constraints nullable="false"/>
            </column>
            <column name="payment_reference" type="varchar(128)"/>
            <column name="created_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="plan_change_request" baseColumnNames="developer_id"
                                 referencedTableName="developer_account" referencedColumnNames="id"
                                 constraintName="fk_plan_change_request_developer"/>
        <createIndex tableName="plan_change_request" indexName="idx_plan_change_request_developer">
            <column name="developer_id"/>
        </createIndex>
    </changeSet>

    <!--
      billing-002 : tarification des plans éditable par l'administrateur (prix, quota, devise). Les
      valeurs de application.yml servent de valeurs par défaut au premier démarrage ; ensuite l'admin
      fixe les prix depuis la console et ils sont persistés ici (source de vérité). Global -> pas de RLS.
    -->
    <changeSet id="billing-002-plan-pricing" author="billing">
        <createTable tableName="plan_pricing">
            <column name="code" type="varchar(32)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="quota_mensuel" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="prix_mensuel" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="devise" type="varchar(8)" defaultValue="XAF">
                <constraints nullable="false"/>
            </column>
            <column name="maj_le" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!--
      billing-003 : métrique hybride — nombre maximal d'applications autorisées par forfait.
      -1 (défaut) = illimité. Fixé par l'administrateur ; appliqué à la création d'application.
    -->
    <changeSet id="billing-003-plan-pricing-apps-max" author="billing">
        <addColumn tableName="plan_pricing">
            <column name="applications_max" type="bigint" defaultValueNumeric="-1">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <!--
      billing-004 : libellé (nom affiché) d'un forfait, librement modifiable par l'administrateur. Le
      `code` reste la clé technique stable référencée par les développeurs ; le libellé n'est qu'un nom
      d'affichage (null => on affiche le code). Permet aussi de nommer un forfait créé de toutes pièces.
    -->
    <changeSet id="billing-004-plan-pricing-libelle" author="billing">
        <addColumn tableName="plan_pricing">
            <column name="libelle" type="varchar(64)"/>
        </addColumn>
    </changeSet>

    <!--
      billing-005 : répare les forfaits payants dont le prix est resté à zéro.

      La colonne `prix_mensuel` a pour défaut 0 et les lignes de `plan_pricing` RECOUVRENT la
      configuration (cf. PlanPricingStore.run) : une base créée sans prix explicite se retrouve donc
      avec des forfaits payants à 0, quels que soient les prix de application.yml. C'est ce qui a été
      constaté en production le 01/08/2026 — PRO et ENTERPRISE affichés à 0.

      Conséquence directe : la commande de paiement partait avec un montant nul, que la passerelle
      mobile money refuse (montant minimum 100 XAF), d'où l'impossibilité de changer de forfait.

      On ne corrige QUE les forfaits payants standard restés à zéro : FREE doit rester gratuit, et un
      prix déjà fixé par l'administrateur n'est jamais écrasé (clause `prix_mensuel = 0`).
    -->
    <changeSet id="billing-005-reparer-prix-forfaits-payants" author="billing">
        <update tableName="plan_pricing">
            <column name="prix_mensuel" valueNumeric="15000"/>
            <where>code = 'PRO' AND prix_mensuel = 0</where>
        </update>
        <update tableName="plan_pricing">
            <column name="prix_mensuel" valueNumeric="75000"/>
            <where>code = 'ENTERPRISE' AND prix_mensuel = 0</where>
        </update>
        <rollback>
            <update tableName="plan_pricing">
                <column name="prix_mensuel" valueNumeric="0"/>
                <where>code IN ('PRO', 'ENTERPRISE')</where>
            </update>
        </rollback>
    </changeSet>

</databaseChangeLog>
